# Copy this file to ".env" (with the dot at the start, no .example) and fill
# in ONE of the API keys below. The .env file is YOURS and stays on your
# computer — it never gets shared on GitHub.

# Pick whichever you already have an account with:

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides — leave commented out unless you know what you're doing.
# NEWSROOM=               # label the dashboard, e.g. NEWSROOM="MakanDay"
# AI_PROVIDER=anthropic   # or "openai" — auto-detected from the key above
# MODEL=                  # e.g. "claude-sonnet-4-6" or "gpt-5.4" to override default
# OPENAI_BASE_URL=        # advanced: route OpenAI calls through OpenRouter, Groq, Ollama
# PORT=3000

# Optional: share usage with Develop AI. OFF by default — leave this commented
# out and nothing about your install ever leaves your computer. If you turn it
# on, the app sends on startup ONLY: a random install id, your newsroom name (if
# set above), the app version, your OS, and activity counts (how many uploads /
# briefs / errors / stories). It NEVER sends story text, headlines, source
# names, or file names. This just lets us see the Node is being used.
# GROUNDED_TELEMETRY=on
